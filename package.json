    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^80.0.0",
    "jscpd": "^5.4.3",
    "knip": "^6.48.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "@typescript/native": "npm:typescript@^7.0.2",
